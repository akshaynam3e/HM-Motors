<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="csrf-token" content="<%= csrf %>"><title>HM Motors — Admin portal</title><link rel="stylesheet" href="/css/admin.css"><script defer src="/js/admin.js"></script></head>
<body class="admin-body">
<% if (!user) { %>
  <main class="login-shell"><div class="login-card"><a class="admin-wordmark" href="/">HM Motors operations</a><p class="eyebrow">PRIVATE STAFF PORTAL</p><h1>Administrator sign-in</h1>
  <% if (!ownerExists) { %><div class="notice notice--warning"><strong>Owner account not initialized.</strong><p>On the server, run <code>npm run create-owner</code> in a terminal. The command securely prompts for the first owner email and password. No public account setup is enabled here.</p></div><% } else { %>
    <form id="login-form"><label>Email<input name="email" type="email" autocomplete="username" maxlength="254" required></label><label>Password<input name="password" type="password" autocomplete="current-password" maxlength="200" required></label><button class="button" type="submit">Sign in</button><p class="form-status" aria-live="polite"></p></form>
  <% } %><a class="login-back" href="/">Return to public website</a></div></main>
<% } else { %>
  <header class="admin-topbar"><a class="admin-wordmark" href="/admin">HM Motors operations</a><div class="admin-user"><span><strong><%= user.name %></strong><small><%= user.role === 'OWNER' ? 'Owner' : 'Administrator' %></small></span><button class="button button--outline" id="change-password">Change password</button><form id="logout-form"><button class="button button--quiet" type="submit">Sign out</button></form></div></header>
  <div class="admin-layout"><aside class="admin-sidebar"><p class="eyebrow">WORKSPACE</p><nav aria-label="Administration"><button class="tab-button is-active" data-panel="dashboard">Overview</button><button class="tab-button" data-panel="inventory">Inventory</button><button class="tab-button" data-panel="offers">Offers</button><button class="tab-button" data-panel="leads">Enquiries & follow-ups</button><button class="tab-button" data-panel="test-rides">Test rides</button><button class="tab-button" data-panel="reports">Reports</button><% if (user.role === 'OWNER') { %><p class="eyebrow sidebar-owner">OWNER CONTROLS</p><button class="tab-button" data-panel="settings">Website settings</button><button class="tab-button" data-panel="admins">Administrators</button><% } %><button class="tab-button" data-panel="audit">Audit history</button></nav><a href="/" class="sidebar-public">View public website</a></aside>
  <main class="admin-main" id="admin-main" data-role="<%= user.role %>">
    <section class="admin-panel is-active" id="panel-dashboard"><div class="panel-heading"><div><p class="eyebrow">SHOWROOM OPERATIONS</p><h1>Overview</h1><p>Operational counts from records entered in this portal; enquiries are not automatically sales.</p></div><button class="button button--outline" data-refresh="dashboard">Refresh</button></div><div id="dashboard-cards" class="metric-grid"></div><div class="dashboard-columns"><section class="admin-card"><h2>Enquiries by source</h2><div id="source-report"></div></section><section class="admin-card"><h2>Most-enquired vehicles</h2><div id="vehicle-report"></div></section></div><p id="metric-notes" class="fine-print"></p></section>
    <section class="admin-panel" id="panel-inventory"><div class="panel-heading"><div><p class="eyebrow">CATALOGUE MANAGEMENT</p><h1>Vehicle inventory</h1><p>List Scooty, Bike, and Car options. Choose New or Second-hand for every listing. Drafts stay out of public pages.</p></div><button class="button" id="new-vehicle">Add listing</button></div><div class="toolbar"><label>Search inventory<input id="vehicle-search" type="search" placeholder="Make, model, or keyword" maxlength="80"></label><label>Publication<select id="vehicle-state"><option value="all">All</option><option value="published">Published</option><option value="draft">Draft / archived</option></select></label><a class="button button--outline" href="/api/admin/vehicles/export.csv">Export CSV</a></div><form id="vehicle-import-form" class="import-form"><label>Import inventory CSV<input type="file" name="file" accept=".csv,text/csv" required></label><button class="button button--outline" type="submit">Import CSV</button><a class="text-link" href="/api/admin/vehicles/export.csv">Download CSV template</a><span class="form-status" aria-live="polite"></span></form><p class="fine-print import-help">Required columns: slug, category, brand, model. Type: SCOOTER / MOTORCYCLE / CAR. Condition: NEW / PRE_OWNED. Maximum 1 MB and 500 rows. Blank slug is generated automatically; an existing slug updates that listing.</p><details id="vehicle-import-errors" class="import-errors" hidden><summary>Review rows with errors</summary><ol id="vehicle-import-error-list"></ol></details><div id="vehicle-table"></div></section>
    <section class="admin-panel" id="panel-offers"><div class="panel-heading"><div><p class="eyebrow">PROMOTIONS</p><h1>Offers & announcements</h1><p>Publish only current, approved terms and dates.</p></div><button class="button" id="new-offer">Add offer</button></div><div id="offer-list"></div></section>
    <section class="admin-panel" id="panel-leads"><div class="panel-heading"><div><p class="eyebrow">CUSTOMER FOLLOW-UP</p><h1>Enquiries</h1><p>Use records for timely, respectful replies. Keep internal notes relevant.</p></div><a class="button button--outline" href="/api/admin/leads/export.csv">Export enquiries CSV</a></div><div class="toolbar"><label>Search leads<input id="lead-search" type="search" maxlength="80"></label><label>Status<select id="lead-status"><option value="">All statuses</option><option>NEW</option><option>CONTACTED</option><option>FOLLOW_UP_REQUIRED</option><option>VISIT_SCHEDULED</option><option>CONVERTED</option><option>CLOSED</option></select></label><label>Type<select id="lead-type"><option value="">All enquiry types</option><option>GENERAL</option><option>TEST_RIDE</option><option>FINANCE</option><option>EXCHANGE</option></select></label></div><div id="lead-list"></div></section>
    <section class="admin-panel" id="panel-test-rides"><div class="panel-heading"><div><p class="eyebrow">HUMAN CONFIRMATION REQUIRED</p><h1>Test-ride requests</h1><p>Requests become confirmed only after a staff member records a confirmation.</p></div></div><div id="test-ride-list"></div></section>
    <section class="admin-panel" id="panel-reports"><div class="panel-heading"><div><p class="eyebrow">MEASUREMENT</p><h1>Reports</h1><p>Counts describe recorded activity, not unique people or guaranteed outcomes.</p></div><button class="button button--outline" data-refresh="dashboard">Refresh report</button></div><div id="report-details"></div></section>
    <% if (user.role === 'OWNER') { %>
    <section class="admin-panel" id="panel-settings"><div class="panel-heading"><div><p class="eyebrow">OWNER CONTROL</p><h1>Website settings</h1><p>Enter only facts confirmed by the business owner. Configure the canonical URL once the real domain uses HTTPS.</p></div></div><form id="settings-form" class="settings-form"><h2>Public identity & contact</h2><div class="field-grid"><label>Public showroom name<input name="site_name" maxlength="160"></label><label>Tagline (optional)<input name="tagline" maxlength="240"></label><label>Legal business name (if applicable)<input name="legal_business_name" maxlength="200"></label><label>Verified public phone<input name="public_phone" maxlength="30"></label><label>Business email<input name="public_email" type="email" maxlength="254"></label><label>WhatsApp number (international digits)<input name="whatsapp_number" maxlength="20"></label><label>Address line<input name="address_line" maxlength="240"></label><label>Locality<input name="locality" maxlength="100"></label><label>District<input name="district" maxlength="100"></label><label>State<input name="state" maxlength="100"></label><label>Postal code<input name="postal_code" maxlength="12"></label><label>Business hours<input name="business_hours" maxlength="240"></label><label>Verified Google Maps/directions URL<input name="map_url" type="url" maxlength="500"></label><label>Public website HTTPS URL<input name="public_base_url" type="url" maxlength="300"></label><label>Privacy contact email<input name="privacy_contact" type="email" maxlength="254"></label><label>GSTIN, only if applicable<input name="gstin" maxlength="30"></label></div><h2>Verified business statements</h2><label>Dealership/service statement — only if verified and permission confirmed<textarea name="dealership_statement" maxlength="1500" rows="3"></textarea></label><label>Privacy notice additions<textarea name="privacy_notice" maxlength="3000" rows="3"></textarea></label><label>Terms additions<textarea name="terms_notice" maxlength="3000" rows="3"></textarea></label><h2>Optional service and review</h2><label class="check-label"><input type="checkbox" name="service_enabled" value="true"> Show the service/after-sales page (only if this business provides the service)</label><label>Service description<textarea name="service_description" maxlength="1500" rows="3"></textarea></label><label>Verified review page URL<input name="review_url" type="url" maxlength="500"></label><h2>Operations</h2><div class="field-grid"><label>Enquiry retention target (days)<input name="retention_days" type="number" min="1" max="3650"></label><label>Low-stock threshold<input name="low_stock_threshold" type="number" min="0" max="10000"></label><label>Stale listing threshold (days)<input name="stale_listing_days" type="number" min="1" max="3650"></label></div><button class="button" type="submit">Save settings</button><p class="form-status" aria-live="polite"></p></form></section>
    <section class="admin-panel" id="panel-admins"><div class="panel-heading"><div><p class="eyebrow">OWNER CONTROL</p><h1>Administrators</h1><p>Only the owner can invite or deactivate an administrator. Invitations expire after 24 hours and are usable once.</p></div></div><form id="invite-form" class="invite-form"><label>Administrator name<input name="name" required maxlength="120"></label><label>Email<input name="email" type="email" required maxlength="254"></label><button class="button" type="submit">Create invite link</button><p class="form-status" aria-live="polite"></p></form><div id="invite-link" class="notice" hidden></div><div id="admin-account-list"></div></section>
    <% } %>
    <section class="admin-panel" id="panel-audit"><div class="panel-heading"><div><p class="eyebrow">ACCOUNTABILITY</p><h1>Audit history</h1><p>Recent administrative actions; customer message content is not copied into the audit log.</p></div><button class="button button--outline" data-refresh="audit">Refresh</button></div><div id="audit-list"></div></section>
    <div id="admin-toast" class="toast" role="status" aria-live="polite"></div>
  </main></div>
  <dialog id="record-dialog" class="record-dialog"><form id="record-form" method="dialog"><div id="dialog-content"></div><div class="dialog-actions"><button class="button button--outline" type="button" data-dialog-close>Cancel</button><button class="button" type="submit">Save</button></div><p class="form-status" aria-live="polite"></p></form></dialog>
  <dialog id="password-dialog" class="record-dialog"><form id="password-form"><h2>Change password</h2><label>Current password<input name="currentPassword" type="password" autocomplete="current-password" required maxlength="200"></label><label>New password<input name="newPassword" type="password" autocomplete="new-password" minlength="14" maxlength="200" required></label><label>Confirm new password<input name="confirmPassword" type="password" autocomplete="new-password" minlength="14" maxlength="200" required></label><p class="fine-print">Use at least 14 characters. Changing a password invalidates all existing sessions for this account.</p><div class="dialog-actions"><button class="button button--outline" type="button" id="cancel-password">Cancel</button><button class="button" type="submit">Update password</button></div><p class="form-status" aria-live="polite"></p></form></dialog>
<% } %>
</body></html>
