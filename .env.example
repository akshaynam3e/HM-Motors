# Copy to .env and replace the values before starting the server.
NODE_ENV=development
PORT=3000
STORAGE_DIR=./storage
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_FROM_OPENSSL_RAND_HEX_32
# local = plain HTTP development; production = HTTPS standalone site; preview = HTTPS cross-site embedded Preview.
APP_COOKIE_MODE=local
# Set to the number of trusted reverse-proxy hops only after checking the hosting topology.
TRUST_PROXY_HOPS=0

# Optional first-deploy owner bootstrap. Set all three privately in Render Environment settings, never in committed source.
# Remove these from the host after the owner has been provisioned and the database is persistent.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
