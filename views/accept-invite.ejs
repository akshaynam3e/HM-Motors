<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="csrf-token" content="<%= csrf %>"><title>Accept administrator invitation</title><link rel="stylesheet" href="/css/admin.css"><script defer src="/js/invite.js"></script></head><body class="admin-body"><main class="login-shell"><section class="login-card"><p class="eyebrow">PRIVATE STAFF PORTAL</p><h1>Administrator invitation</h1><% if (invite) { %><p>This one-time invitation is for <strong><%= invite.name %></strong> (<%= invite.email %>). It expires <%= new Date(invite.expires_at).toLocaleString() %>.</p><form id="accept-invite-form" data-token="<%= token %>"><label>Create password<input name="password" type="password" minlength="14" maxlength="200" autocomplete="new-password" required></label><label>Confirm password<input name="confirmPassword" type="password" minlength="14" maxlength="200" autocomplete="new-password" required></label><p class="fine-print">Use at least 14 characters. Do not share the invitation link.</p><button class="button" type="submit">Create administrator account</button><p class="form-status" aria-live="polite"></p></form><% } else { %><div class="notice notice--warning"><p>This invitation link is invalid, expired, or already used. Ask the owner for a new invitation.</p></div><% } %><a class="login-back" href="/admin">Return to sign-in</a></section></main></body></html>
